library("dampack")
library(gt)
library(tidyverse)
library(magrittr)
alternatives <- c(0, 1, 2, 3, 4, 9)
filenames <- list.files(det_output_path, full.names = TRUE)
alldata <- lapply(filenames, function(x) {
get(load(x, .GlobalEnv))
})
alldata <- do.call("rbind", alldata)
View(alldata)
